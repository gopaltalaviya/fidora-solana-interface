# Which Solana cluster the site reads: localnet or devnet (default devnet).
# Mainnet and testnet are refused.
FIDORA_CLUSTER=
# The RPC the server reads. Empty: http://127.0.0.1:8899 on localnet,
# the public devnet RPC on devnet. Never a mainnet URL.
FIDORA_RPC_URL=https://api.devnet.solana.com
# Ignore program events before this slot (an older deployment). Default 0.
FIDORA_START_SLOT=
# How long the server caches each chain read, in ms. Default 15000.
FIDORA_CACHE_MS=
# The most program transactions the event scan reads. Default 2000.
FIDORA_MAX_TRANSACTIONS=
